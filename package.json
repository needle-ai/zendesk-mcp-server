{
      "name": "zendesk-mcp-server",
      "version": "1.0.0",
      "type": "module",
      "description": "MCP Server for Zendesk API",
      "main": "src/index.js",
      "bin": {
        "zendesk-mcp": "src/stdio.js"
      },      
      "scripts": {
        "start": "bun src/stdio.js",
        "dev": "bun --watch src/stdio.js",
        "build": "bun build src/index.js --outfile dist/index.js",
        "inspect": "bunx -y @modelcontextprotocol/inspector node src/stdio.js"
      },
      "dependencies": {
        "@modelcontextprotocol/sdk": "^1.0.0",
        "axios": "^1.6.2",
        "dotenv": "^16.3.1",
        "zod": "^3.22.4"
      }
    }
